filters:
  and:
    - file.inFolder("娱乐/番剧")
formulas:
  标签: |-
    tags
    .map(value.replace('#',''))
    .join('，')
  观看时间: |-
    if(note["开始日期"], date(note["开始日期"]).format("YYYY年MM月DD日"), "未知")
    +
    " - "
    +
    if(note["结束日期"], date(note["结束日期"]).format("YYYY年MM月DD日"), today().format("YYYY年MM月DD日"))
  放送日期: date(note["放送日期"]).format("YYYY年MM月DD日")
views:
  - type: cards
    name: 卡片
    order:
      - file.name
      - 制作组
      - formula.放送日期
      - 状态
      - formula.标签
      - formula.观看时间
    sort:
      - property: 结束日期
        direction: ASC
    image: note.封面
    imageFit: contain
    imageAspectRatio: 1
    cardSize: 220
  - type: table
    name: 表格
    order:
      - file.name
      - 制作组
      - 放送日期
      - 状态
      - formula.标签
    sort:
      - property: 放送日期
        direction: ASC
    columnSize:
      file.name: 168
      note.制作组: 101
      note.放送日期: 116
