filters:
  and:
    - file.inFolder("娱乐/漫画")
formulas:
  标签: |-
    tags
    .map(value.replace('#',''))
    .join('，')
  观看时间: |-
    if(开始日期, date(开始日期).format("YYYY年MM月DD日"), "未知")
    +
    " - "
    +
    if(结束日期, date(结束日期).format("YYYY年MM月DD日"), today().format("YYYY年MM月DD日"))
  连载日期: date(连载日期).format("YYYY年MM月DD日")
views:
  - type: cards
    name: 卡片
    order:
      - file.name
      - 作者
      - formula.连载日期
      - 发行杂志
      - 状态
      - formula.标签
      - formula.观看时间
    sort:
      - property: 结束日期
        direction: ASC
    image: note.封面
    imageFit: contain
    imageAspectRatio: 1
    cardSize: 230
  - type: table
    name: 表格
    order:
      - file.name
      - 作者
      - 发行杂志
      - 连载日期
      - 状态
      - formula.标签
    sort:
      - property: 放送日期
        direction: ASC
    columnSize:
      file.name: 168
      note.制作组: 101
      note.放送日期: 116
